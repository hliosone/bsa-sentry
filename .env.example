# BSA Sentry - copy to .env and fill with: pnpm keys  (.env is gitignored)
CHAIN=arc
ARC_RPC_URL=https://rpc.testnet.arc.io
CHAIN_ID=5042002
USDC_ADDRESS=0x...

# Speculos (Flex emulator). Fresh random seed, not Speculos' public default.
SPECULOS_SEED="twelve words go here - generated by scripts/gen-keys.ts"
SPECULOS_MAIN_ADDRESS=0x...
SPECULOS_AGENT_ADDRESS=0x...

# Funding / infrastructure
TREASURY_PRIVATE_KEY=0x...
TREASURY_ADDRESS=0x...
FACILITATOR_PRIVATE_KEY=0x...
FACILITATOR_ADDRESS=0x...
ISSUER_PRIVATE_KEY=0x...
ISSUER_ADDRESS=0x...

# Merchant payTo addresses (one per merchant, distinct)
MERCHANT_CAFE_PRIVATE_KEY=0x...
MERCHANT_CAFE_ADDRESS=0x...
MERCHANT_CAVE_PRIVATE_KEY=0x...
MERCHANT_CAVE_ADDRESS=0x...
MERCHANT_RESTO_PRIVATE_KEY=0x...
MERCHANT_RESTO_ADDRESS=0x...
MERCHANT_EVIL_PRIVATE_KEY=0x...
MERCHANT_EVIL_ADDRESS=0x...

SESSION_SECRET=64 hex chars
MERCHANT_BOULANGERIE_PRIVATE_KEY=0x...
MERCHANT_BOULANGERIE_ADDRESS=0x...

# 18+ (see docs/EUDIW.md)
EUDIW_MODE=mock
VERIFIER_BACKEND=https://verifier-backend.eudiw.dev
INTENDED_USE_ID=TEST-01
EUDIW_QR_SCHEME=openid4vp

# Token presale merchant (optional; not open to US nationals)
MERCHANT_PRESALE_PRIVATE_KEY=
MERCHANT_PRESALE_ADDRESS=
# Optional: an extra issuer CA to trust for the EU verifier, base64 of its PEM (scripts/test-issuer.ts prints it)
EUDIW_EXTRA_ISSUER_CA=

# Shopify store, shoppable by AI agents at <MERCHANT_URL>/shopify (see docs/SHOPIFY.md).
# With no credentials it runs in DRY_RUN: built-in demo catalog, real settlement, no order write-back.
# Payee for every Shopify sale (falls back to MERCHANT_BOULANGERIE_ADDRESS if empty)
MERCHANT_SHOPIFY_PRIVATE_KEY=
MERCHANT_SHOPIFY_ADDRESS=
# The store domain, e.g. your-store.myshopify.com
SHOPIFY_SHOP=
# EITHER a Dev Dashboard app's client credentials (exchanged for a 24 h token automatically)...
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# ...OR an Admin API access token (shpat_..., legacy custom apps created before 2026)
SHOPIFY_ADMIN_TOKEN=
# Admin GraphQL API version
SHOPIFY_API_VERSION=2025-07
# true = demo catalog and no order write-back even with credentials (forced when no credentials)
SHOPIFY_DRY_RUN=false
# Explorer used in receipts and order notes (also read by the server)
ARC_EXPLORER=https://explorer.testnet.arc.io
