{
  "name": "bsa-sentry",
  "private": true,
  "packageManager": "pnpm@10.29.1",
  "scripts": {
    "test": "pnpm -r test",
    "keys": "tsx scripts/gen-keys.ts",
    "balances": "tsx scripts/balances.ts",
    "fund": "tsx scripts/fund.ts",
    "recycle": "tsx scripts/recycle.ts",
    "check:domain": "tsx scripts/check-domain.ts",
    "typecheck": "for p in packages/types packages/sentry-signer apps/server apps/merchants apps/web; do echo \"== $p\"; tsc -p $p/tsconfig.json --noEmit || exit 1; done",
    "test:speculos": "vitest run --config vitest.speculos.config.ts",
    "smoke": "tsx scripts/device-smoke.ts",
    "harness": "tsx scripts/bridge-harness.ts",
    "e2e:cafe": "tsx scripts/e2e-cafe.ts",
    "e2e:mcp": "tsx scripts/e2e-mcp.ts",
    "tunnel": "tsx scripts/tunnel.ts",
    "test:web": "pnpm --filter @bsa-sentry/web exec playwright test",
    "e2e:age": "tsx scripts/e2e-age.ts",
    "e2e:restore": "tsx scripts/e2e-restore.ts",
    "demo": "tsx scripts/demo.ts",
    "e2e": "tsx scripts/e2e.ts",
    "demo:up": "bash scripts/demo-up.sh"
  },
  "devDependencies": {
    "@bsa-sentry/sentry-signer": "workspace:*",
    "@bsa-sentry/types": "workspace:*",
    "@bsa-sentry/web": "workspace:*",
    "@ledgerhq/hw-transport-node-hid": "^6.33.5",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "viem": "^2.22.0",
    "vitest": "^2.1.9",
    "ws": "^8.22.0"
  },
  "type": "module"
}
